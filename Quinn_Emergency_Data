address_lookup <- Incidents_2014_2018 %>% #this grabs the addresses 
  transmute(                             #and makes a lookup table
    match_addr = str_squish(as.character(match_addr))
  ) %>%
  filter(
    !is.na(match_addr),
    match_addr != ""
  ) %>%
  distinct(match_addr) %>%
  mutate(address_id = row_number())

#This splits up the address limit so tidygeocoder doesnt break
address_batches <- split(
  address_lookup,
  ceiling(seq_len(nrow(address_lookup)) / 9000)
)

# These are the functions used to assign census blocks to each address 
census_lookup <- map_dfr(
  address_batches,
  function(x) {
    
    geocode(
      x,
      address = "match_addr",
      method = "census",
      full_results = TRUE,
      
      # Return census geography information
      api_options = list(
        census_return_type = "geographies"
      ),
      
      # Use 2010 Census geographic boundaries
      custom_query = list(
        benchmark = "Public_AR_Current",
        vintage = "Census2010_Current"
      ),
      
      batch_limit = 9000,
      verbose = TRUE
    )
  }
)
