translated_incidents_2014_2018 <- Incidents_2014_2018 %>%
  mutate(
    across(
      c(inc_type, act_tak1, act_tak2, act_tak3),
      as.character
    )
  ) %>%
  
  # Translate incident type
  left_join(
    code_lookup %>%
      rename(inc_type_name = code_name),
    by = c("inc_type" = "code")
  ) %>%
  
  # Translate first action taken
  left_join(
    action_taken_codes %>%
      transmute(
        code = as.character(code),
        act_tak1_name = code_name
      ),
    by = c("act_tak1" = "code")
  ) %>%
  
  # Translate second action taken
  left_join(
    action_taken_codes %>%
      transmute(
        code = as.character(code),
        act_tak2_name = code_name
      ),
    by = c("act_tak2" = "code")
  ) %>%
  
  # Translate third action taken
  left_join(
    action_taken_codes %>%
      transmute(
        code = as.character(code),
        act_tak3_name = code_name
      ),
    by = c("act_tak3" = "code")
  ) %>%
  
  arrange(desc(fdid))

